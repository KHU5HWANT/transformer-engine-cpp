# ════════════════════════════════════════════════════════════════════════════
# transformer-chat — Environment Configuration
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# For production builds on Vercel / Netlify: set these in the platform's
# environment variable dashboard instead of committing a .env file.
#
# ⚠  All VITE_ variables are embedded in the JS bundle at build time.
#    Do NOT put secrets here — they will be visible in the browser.
# ════════════════════════════════════════════════════════════════════════════

# ── C++ inference server URL ─────────────────────────────────────────────────
# LOCAL:      http://localhost:8080
# PRODUCTION: https://your-domain.com  (nginx reverse-proxies /predict)
#             or http://YOUR_SERVER_IP:8080  (direct, if CORS is enabled)
#
# In development the Vite proxy rewrites /api/* → VITE_API_BASE_URL/*
# so CORS never fires in the browser during dev.
VITE_API_BASE_URL=http://localhost:8080

# ── Generation parameters ────────────────────────────────────────────────────
# Maximum characters to auto-regressively generate per response
VITE_MAX_GEN_TOKENS=300

# Per-token request timeout in milliseconds
VITE_TOKEN_TIMEOUT_MS=8000

# ── App metadata (displayed in UI) ──────────────────────────────────────────
VITE_MODEL_NAME=C++ Transformer v1.0
VITE_APP_TITLE=TransformerChat
